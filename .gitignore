.DS_Store
Thumbs.db
node_modules/
.env
dist/
build/
.gstack/

# Personal Linear API key (never commit)
.linear-key

# Holds this project's personal credentials (GH_TOKEN) and the company-MCP deny
# rule. A global ignore also covers it, but that lives on one machine and this
# repo is PUBLIC — so the rule is repeated here where it travels with the repo.
.claude/settings.local.json

# GGC pipeline runtime artifacts — /dev:verify sanitizes these from the index
# by design, so they are per-run scratch, not repo content.
.dev/

# Claude harness files generated by `openspec init/update` — regenerable, and
# machine-local like .claude/settings.local.json. Deliberately-authored skills
# (e.g. .claude/skills/commit/) stay tracked; already-tracked files are
# unaffected by these rules.
.claude/commands/opsx/
.claude/skills/openspec-*/
